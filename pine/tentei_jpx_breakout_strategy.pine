//@version=6
strategy(
     "天底 JPX 50日ブレイク戦略 [日足]",
     overlay = true,
     initial_capital = 1000000,
     currency = currency.JPY,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 50,
     pyramiding = 2,
     commission_type = strategy.commission.percent,
     commission_value = 0.15,
     slippage = 1,
     process_orders_on_close = false,
     calc_on_order_fills = true,
     use_bar_magnifier = true,
     margin_long = 100,
     margin_short = 100)

// JPX銘柄500件・日足5年の横断検証から選んだ、買い専用の研究戦略です。
// シグナル履歴やBotのスコアは参照しません。注文はシグナル翌足の始値で約定します。

string GROUP_TEST = "バックテスト"
string GROUP_ENTRY = "エントリー"
string GROUP_RISK = "損切り・利確"
string GROUP_VIEW = "表示"

int startDate = input.time(timestamp("18 Jul 2021 00:00 +0900"), "開始日", group = GROUP_TEST)
int endDate = input.time(timestamp("31 Dec 2035 00:00 +0900"), "終了日", group = GROUP_TEST)
string benchmarkSymbol = input.symbol("TSE:1306", "相場判定（TOPIX ETF）", group = GROUP_ENTRY)
float minTurnoverYen = input.float(300000000, "最低20日平均売買代金（円）", minval = 0, step = 10000000, group = GROUP_ENTRY)
float minVolumeRatio = input.float(1.2, "最低出来高倍率", minval = 0.1, step = 0.1, group = GROUP_ENTRY)
float maxAtrPct = input.float(8.0, "最大ATR（株価比％）", minval = 1.0, step = 0.5, group = GROUP_ENTRY) / 100.0
bool enableAdd = input.bool(false, "利益が乗った時だけ1回買い増す", group = GROUP_ENTRY,
     tooltip = "初回価格から+0.75Rかつ10日高値更新で、翌足始値に50%追加します。損失中のナンピンはしません。")

float stopAtr = input.float(2.5, "最大損切り幅（ATR倍）", minval = 1.0, step = 0.25, group = GROUP_RISK)
float lockAtR = input.float(1.5, "利益保護を始めるR", minval = 0.5, step = 0.25, group = GROUP_RISK)
float finalTargetR = input.float(6.0, "最終利確R", minval = 2.0, step = 0.5, group = GROUP_RISK)
float trailAtr = input.float(2.5, "追随ストップ（ATR倍）", minval = 1.0, step = 0.25, group = GROUP_RISK)
int maxHoldBars = input.int(80, "最大保有日数", minval = 10, group = GROUP_RISK)

bool showAverages = input.bool(true, "移動平均線を表示", group = GROUP_VIEW)
bool showMarketShade = input.bool(true, "相場良好時の背景を表示", group = GROUP_VIEW)
bool showGuide = input.bool(true, "初心者向け状態パネルを表示", group = GROUP_VIEW)

float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float atr14 = ta.atr(14)
float rsi14 = ta.rsi(close, 14)
float priorHigh50 = ta.highest(high, 50)[1]
float priorHigh10 = ta.highest(high, 10)[1]
float priorLow10 = ta.lowest(low, 10)[1]
float priorVolume20 = ta.sma(volume, 20)[1]
float volumeRatio = volume / priorVolume20
float priorTurnover20 = ta.sma(close * volume, 20)[1]
float atrPct = atr14 / close

[marketClose, marketEma50, marketEma200, marketEma200Ago] = request.security(
     benchmarkSymbol,
     "D",
     [close, ta.ema(close, 50), ta.ema(close, 200), ta.ema(close, 200)[20]],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

bool marketOk = marketClose > marketEma200 and marketEma50 > marketEma200 and marketEma200 > marketEma200Ago
bool dateOk = time >= startDate and time <= endDate
bool dailyOk = timeframe.isdaily
bool liquidOk = priorTurnover20 >= minTurnoverYen and atrPct <= maxAtrPct
bool trendOk = close > ema200 and ema20 > ema50 and ema50 > ema50[5]
bool momentumOk = rsi14 >= 50 and rsi14 <= 75 and volumeRatio >= minVolumeRatio
bool breakoutOk = close > priorHigh50
bool enoughHistory = not na(ema200[20]) and not na(priorHigh50) and not na(marketEma200Ago)
bool entrySignal = dailyOk and dateOk and enoughHistory and marketOk and liquidOk and trendOk and momentumOk and breakoutOk and strategy.position_size == 0

var bool tradeInitialized = false
var bool addOrderSent = false
var bool profitLocked = false
var int entryBar = na
var float initialEntry = na
var float initialRisk = na
var float hardStop = na
var float activeStop = na
var float lockLevel = na
var float finalTarget = na
var float highestClose = na
var float observedPositionSize = 0.0

bool initialFill = strategy.position_size > 0 and not tradeInitialized
bool addFill = tradeInitialized and strategy.position_size > observedPositionSize and observedPositionSize > 0
bool exitFill = strategy.position_size == 0 and tradeInitialized

if initialFill
    float fillAtr = atr14[1]
    float fillSwingLow = priorLow10[1]
    float swingDistance = math.max(fillAtr, strategy.position_avg_price - (fillSwingLow - 0.2 * fillAtr))
    initialRisk := math.max(fillAtr, math.min(stopAtr * fillAtr, swingDistance))
    initialEntry := strategy.position_avg_price
    hardStop := initialEntry - initialRisk
    activeStop := hardStop
    lockLevel := initialEntry + lockAtR * initialRisk
    finalTarget := initialEntry + finalTargetR * initialRisk
    highestClose := close
    entryBar := bar_index
    tradeInitialized := true
    addOrderSent := false
    profitLocked := false

if tradeInitialized and strategy.position_size > 0
    highestClose := math.max(highestClose, close)

    if not profitLocked and high >= lockLevel
        profitLocked := true

    if profitLocked
        float trailingStop = highestClose - trailAtr * atr14
        float candidateStop = math.max(hardStop, strategy.position_avg_price)
        candidateStop := math.max(candidateStop, trailingStop)
        candidateStop := math.max(candidateStop, ema20)
        if candidateStop < close
            activeStop := math.max(activeStop, candidateStop)

    strategy.exit("損切り／最終利確", "Long", stop = activeStop, limit = finalTarget)

    int barsHeld = bar_index - entryBar
    float trendFloor = profitLocked ? ema20 : ema50
    if close < trendFloor
        strategy.close("Long", comment = "トレンド撤退")
    else if barsHeld >= maxHoldBars
        strategy.close("Long", comment = "80日経過")

    bool addSignal = enableAdd and not addOrderSent and not profitLocked and barsHeld >= 2 and close >= initialEntry + 0.75 * initialRisk and close > priorHigh10 and close > ema20 and close >= ema50
    if addSignal
        strategy.entry("Long", strategy.long, comment = "利益中の買い増し")
        addOrderSent := true

if entrySignal
    strategy.entry("Long", strategy.long, comment = "50日高値ブレイク")

if exitFill
    tradeInitialized := false
    addOrderSent := false
    profitLocked := false
    entryBar := na
    initialEntry := na
    initialRisk := na
    hardStop := na
    activeStop := na
    lockLevel := na
    finalTarget := na
    highestClose := na

observedPositionSize := strategy.position_size

plot(showAverages ? ema20 : na, "EMA 20", color = color.new(color.aqua, 0), linewidth = 1)
plot(showAverages ? ema50 : na, "EMA 50", color = color.new(color.orange, 0), linewidth = 2)
plot(showAverages ? ema200 : na, "EMA 200", color = color.new(color.blue, 25), linewidth = 2)
plot(tradeInitialized ? initialEntry : na, "初回エントリー", color = color.new(color.white, 0), linewidth = 2, style = plot.style_linebr)
plot(tradeInitialized ? activeStop : na, "損切り／追随ストップ", color = color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
plot(tradeInitialized ? lockLevel : na, "利益保護開始", color = color.new(color.yellow, 0), linewidth = 1, style = plot.style_linebr)
plot(tradeInitialized ? finalTarget : na, "最終利確", color = color.new(color.lime, 0), linewidth = 2, style = plot.style_linebr)

bgcolor(showMarketShade and marketOk ? color.new(color.green, 92) : na, title = "TOPIX上昇局面")
plotshape(entrySignal, title = "買い準備", text = "買い\n準備", style = shape.labelup, location = location.belowbar, color = color.new(color.blue, 0), textcolor = color.white, size = size.tiny)
plotshape(initialFill, title = "買い約定", text = "買い", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
plotshape(addFill, title = "買い増し約定", text = "増し", style = shape.labelup, location = location.belowbar, color = color.new(color.teal, 0), textcolor = color.white, size = size.small)
plotshape(exitFill, title = "決済", text = "決済", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny)

var table guide = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islastconfirmedhistory or barstate.isrealtime
    if showGuide
        string stateText = not dailyOk ? "日足へ変更" : tradeInitialized ? profitLocked ? "利益を保護中" : "保有中" : marketOk ? "条件待ち" : "相場待ち"
        color stateColor = not dailyOk ? color.orange : tradeInitialized ? color.green : marketOk ? color.blue : color.gray
        table.cell(guide, 0, 0, "状態", text_color = color.white, bgcolor = color.new(color.black, 10))
        table.cell(guide, 1, 0, stateText, text_color = color.white, bgcolor = stateColor)
        table.cell(guide, 0, 1, "青", text_color = color.white, bgcolor = color.new(color.blue, 20))
        table.cell(guide, 1, 1, "翌日買い準備", text_color = color.white, bgcolor = color.new(color.black, 20))
        table.cell(guide, 0, 2, "赤線", text_color = color.white, bgcolor = color.new(color.red, 20))
        table.cell(guide, 1, 2, "損切り位置", text_color = color.white, bgcolor = color.new(color.black, 20))
        table.cell(guide, 0, 3, "黄線", text_color = color.black, bgcolor = color.new(color.yellow, 10))
        table.cell(guide, 1, 3, "利益保護開始", text_color = color.white, bgcolor = color.new(color.black, 20))
        table.cell(guide, 0, 4, "緑線", text_color = color.black, bgcolor = color.new(color.lime, 10))
        table.cell(guide, 1, 4, "最終利確", text_color = color.white, bgcolor = color.new(color.black, 20))
    else
        table.clear(guide, 0, 0, 1, 4)
