# ========================================
# .env.example — コピーして .env として保存
# ========================================

# ── Discord ─────────────────────────────
# Discord Developer Portal で取得したBotトークン
DISCORD_TOKEN=your_discord_bot_token_here

# Discordサーバーで作成するロール名（このロールを持つ人だけ !scan を実行できる）
ALLOWED_ROLE_NAME=シグナル受信者

# ── Google Sheets ────────────────────────
# SpreadsheetのURL中の /d/XXXXXXXX/ の部分
SPREADSHEET_ID=your_spreadsheet_id_here

# サービスアカウントのJSONファイルパス（プロジェクト直下に置く場合はこのまま）
GOOGLE_CREDENTIALS_PATH=./credentials.json

# シート名（GASが書き込むシート名と一致させること）
OHLCV_SHEET_NAME=ohlcv_4h
ALERTS_SHEET_NAME=alerts_raw
SIGNAL_FEATURE_SNAPSHOT_SHEET_NAME=signal_feature_snapshots

# ── スクリーニング設定 ───────────────────
# Stableモード: このスコア以上を表示（最大4）
SCORE_STABLE=4

# Aggressiveモード: このスコア以上を表示
SCORE_AGGRESSIVE=1

# 結果の最大表示件数
MAX_RESULTS=20

# /scan の標準対象期間（未指定時）。週末を除いた営業日数。
RECENT_SIGNAL_BUSINESS_DAYS=45

# /scan で日数を明示指定した場合の互換用カレンダー日数
RECENT_SIGNAL_DAYS=30

# /help のバックテスト実績表示期間。HTMLレポートに合わせて過去1年。
HELP_BACKTEST_DAYS=365

# スクリーニングに必要な最低4時間足本数
MIN_4H_BARS=30

# ── 管理者設定（承認ワークフロー用）────────────
# /approve-update を実行できるDiscordユーザーID（空白=全員許可）
ADMIN_USER_ID=your_discord_user_id_here

# GitHub Personal Access Token（actions:write スコープが必要）
GITHUB_TOKEN=your_github_pat_here

# GitHubリポジトリ（owner/repo 形式）
GITHUB_REPO=Ken5InvestmentLab/screening-bot
