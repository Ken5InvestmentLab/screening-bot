  "screener_code": "// 自動最適化(方式A) 2026-05-14 06:46 / 1428件データ\n// ★6: 22件 勝率63.6% 平均3.6% 上昇5件 下落1件\n// 現行: 勝率56.2% 平均7.5%\n// 【6条件（各1点）】\n//   ① 当日出来高≥20日×1.5\n//   ② MACD GC（3日以内）\n//   ③ ATR% < 5.0%\n//   ④ 直近20日高値更新\n//   ⑤ ストキャス≥60\n//   ⑥ 一目: close > 基準線\n\nfunction calculateScore(ind) {\n  if (!ind) return null;\n  const filters = [];\n  let score = 0;\n\n  // ① 当日出来高≥20日×1.5\n  if (ind.volSurge >= 1.5) {\n    score++;\n    filters.push(`①vol急増(${ind.volSurge}x)`);\n  }\n\n  // ② MACD GC（3日以内）\n  if (ind.macdGC3d) {\n    score++;\n    filters.push(`②MACD-GC`);\n  }\n\n  // ③ ATR% < 5.0%\n  if (ind.atrPct < 5.0) {\n    score++;\n    filters.push(`③ATR(${ind.atrPct}%)`);\n  }\n\n  // ④ 直近20日高値更新\n  if (ind.hiBrk20) {\n    score++;\n    filters.push(`④高値更新`);\n  }\n\n  // ⑤ ストキャス≥60\n  if (ind.stochK >= 60) {\n    score++;\n    filters.push(`⑤STOCH(${ind.stochK.toFixed(0)})`);\n  }\n\n  // ⑥ 一目: close > 基準線\n  if (ind.ichKijun !== null && ind.close > ind.ichKijun) {\n    score++;\n    filters.push(`⑥一目>基準`);\n  }\n\n  return { score, filters };\n}",
