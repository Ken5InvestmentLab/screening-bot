  "screener_code": "// 自動最適化(方式A) 2026-08-04 13:49 / 3201件データ\n// ★6: 24件 勝率60.9% 平均5.8% 上昇8件 下落0件\n// 現行: 勝率55.3% 平均7.5%\n// 【6条件（各1点）】\n//   ① 当日出来高≥20日×1.2\n//   ② 強い陽線（実体≥0.5%）\n//   ③ 直近20日高値更新\n//   ④ RSI 50〜70\n//   ⑤ 一目: close > 雲上限\n//   ⑥ VP support/overhead >= 1.25\n\nfunction calculateScore(ind) {\n  if (!ind) return null;\n  const filters = [];\n  let score = 0;\n\n  // ① 当日出来高≥20日×1.2\n  if (ind.volSurge >= 1.2) {\n    score++;\n    filters.push(`①vol急増(${ind.volSurge}x)`);\n  }\n\n  // ② 強い陽線（実体≥0.5%）\n  if (ind.isStrongBull) {\n    score++;\n    filters.push(`②強陽線(${ind.bodyPct.toFixed(1)}%)`);\n  }\n\n  // ③ 直近20日高値更新\n  if (ind.hiBrk20) {\n    score++;\n    filters.push(`③高値更新`);\n  }\n\n  // ④ RSI 50〜70\n  if (!isNaN(ind.rsi14) && ind.rsi14 >= 50 && ind.rsi14 < 70) {\n    score++;\n    filters.push(`④RSI(${ind.rsi14.toFixed(0)})`);\n  }\n\n  // ⑤ 一目: close > 雲上限\n  if (ind.ichCloudTop !== null && ind.close > ind.ichCloudTop) {\n    score++;\n    filters.push(`⑤一目雲上`);\n  }\n\n  // ⑥ VP support/overhead >= 1.25\n  if (ind.vpSupportRatio >= 1.25) {\n    score++;\n    filters.push(`⑥VP支持(${ind.vpSupportRatio.toFixed(2)}x)`);\n  }\n\n  return { score, filters };\n}",
