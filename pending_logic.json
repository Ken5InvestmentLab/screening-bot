  "screener_code": "// 自動最適化(方式A) 2026-05-11 08:22 / 1379件データ\n// ★6: 30件 勝率66.7% 平均3.4% 上昇2件 下落0件\n// 現行: 勝率58.6% 平均8.3%\n// 【6条件（各1点）】\n//   ① 当日出来高≥20日×1.5\n//   ② ATR% < 5.0%\n//   ③ ストキャス≥60\n//   ④ RSI 40〜60\n//   ⑤ BB位置≥80%\n//   ⑥ 一目: close > 基準線\n\nfunction calculateScore(ind) {\n  if (!ind) return null;\n  const filters = [];\n  let score = 0;\n\n  // ① 当日出来高≥20日×1.5\n  if (ind.volSurge >= 1.5) {\n    score++;\n    filters.push(`①vol急増(${ind.volSurge}x)`);\n  }\n\n  // ② ATR% < 5.0%\n  if (ind.atrPct < 5.0) {\n    score++;\n    filters.push(`②ATR(${ind.atrPct}%)`);\n  }\n\n  // ③ ストキャス≥60\n  if (ind.stochK >= 60) {\n    score++;\n    filters.push(`③STOCH(${ind.stochK.toFixed(0)})`);\n  }\n\n  // ④ RSI 40〜60\n  if (!isNaN(ind.rsi14) && ind.rsi14 >= 40 && ind.rsi14 < 60) {\n    score++;\n    filters.push(`④RSI(${ind.rsi14.toFixed(0)})`);\n  }\n\n  // ⑤ BB位置≥80%\n  if (ind.bbPct >= 0.80) {\n    score++;\n    filters.push(`⑤BB上部(${(ind.bbPct*100).toFixed(0)}%)`);\n  }\n\n  // ⑥ 一目: close > 基準線\n  if (ind.ichKijun !== null && ind.close > ind.ichKijun) {\n    score++;\n    filters.push(`⑥一目>基準`);\n  }\n\n  return { score, filters };\n}",
