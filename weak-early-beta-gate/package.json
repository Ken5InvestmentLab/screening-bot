{
  "name": "screening-bot-weak-early-beta-gate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run verify-release && npm run verify-canonical && npm run types && npm run test && npm run typecheck && npm run deploy:dry-run && npm run preview:dry-run",
    "verify-canonical": "node scripts/verify-canonical-input.mjs",
    "verify-release": "node scripts/verify-release-config.mjs",
    "preview:dry-run": "wrangler deploy --dry-run --env preview",
    "dev:preview": "wrangler dev --local --env preview",
    "test": "node --test ../tests/report_gate_auth.test.cjs ../tests/cloud_gate_membership.test.cjs ../tests/cloud_report_preferences.test.cjs ../tests/cloud_scenarios.test.cjs ../tests/cloud_display_settings.test.cjs ../tests/cloud_bundle_sync.test.cjs ../tests/cloud_push.test.cjs ../tests/cloud_push_ui.test.cjs ../tests/cloud_release_config.test.cjs ../tests/cloud_whop_adapter.test.cjs ../tests/cloud_push_scheduler.test.cjs ../tests/cloud_canonical_input.test.cjs",
    "deploy": "npm run verify-release && npm run verify-canonical && npm run sync-shared && npm run sync-report && wrangler deploy --env= --minify",
    "deploy:dry-run": "npm run sync-shared && npm run sync-report && wrangler deploy --env= --dry-run",
    "sync-report": "node scripts/sync-report.mjs",
    "sync-shared": "node scripts/sync-shared-gate.mjs",
    "typecheck": "tsc --noEmit",
    "types": "npm run sync-shared && wrangler types"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "wrangler": "4.135.0"
  }
}
