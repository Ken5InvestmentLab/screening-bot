  "screener_code": "// 自動最適化(方式A) 2026-05-14 17:56 / 1482件データ\n// ★6: 20件 勝率65.0% 平均12.3% 上昇6件 下落0件\n// 現行: 勝率54.1% 平均6.3%\n// 【6条件（各1点）】\n//   ① 当日出来高≥20日×1.5\n//   ② 当日出来高≥20日×1.2\n//   ③ ATR% < 5.0%\n//   ④ ATR% < 7.0%\n//   ⑤ ストキャス≥75\n//   ⑥ 直近3日連続下落後\n\nfunction calculateScore(ind) {\n  if (!ind) return null;\n  const filters = [];\n  let score = 0;\n\n  // ① 当日出来高≥20日×1.5\n  if (ind.volSurge >= 1.5) {\n    score++;\n    filters.push(`①vol急増(${ind.volSurge}x)`);\n  }\n\n  // ② 当日出来高≥20日×1.2\n  if (ind.volSurge >= 1.2) {\n    score++;\n    filters.push(`②vol急増(${ind.volSurge}x)`);\n  }\n\n  // ③ ATR% < 5.0%\n  if (ind.atrPct < 5.0) {\n    score++;\n    filters.push(`③ATR(${ind.atrPct}%)`);\n  }\n\n  // ④ ATR% < 7.0%\n  if (ind.atrPct < 7.0) {\n    score++;\n    filters.push(`④ATR(${ind.atrPct}%)`);\n  }\n\n  // ⑤ ストキャス≥75\n  if (ind.stochK >= 75) {\n    score++;\n    filters.push(`⑤STOCH(${ind.stochK.toFixed(0)})`);\n  }\n\n  // ⑥ 直近3日連続下落後\n  if (ind.preDown3) {\n    score++;\n    filters.push(`⑥3連陰後`);\n  }\n\n  return { score, filters };\n}",
