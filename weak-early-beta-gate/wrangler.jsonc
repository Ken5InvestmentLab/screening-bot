{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tentei-kyokuchi-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-07",
  "preview_urls": false,
  "version_metadata": { "binding": "CLOUD_VERSION_METADATA" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [{ "name": "CLOUD_ROLE_AUTHORITY", "class_name": "CloudRoleAuthority" }]
  },
  "migrations": [{ "tag": "cloud-role-authority-v1", "new_sqlite_classes": ["CloudRoleAuthority"] }],
  "d1_databases": [
    {
      "binding": "CLOUD_DB",
      "database_name": "tentei-cloud-settings",
      "database_id": "e0cdb3a7-b682-4db8-96ac-f2afcc9c23cb",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DISCORD_API_BASE": "https://discord.com/api",
    "DISCORD_GUILD_ID": "1479418833352785944",
    "DISCORD_ALLOWED_ROLE_IDS": "1487089073385373828",
    "ACCESS_PURCHASE_URL": "https://whop.com/scoring-bot/tenteikyokuchi/",
    "REPORT_ASSET_PATH": "/weak_early_beta_latest.html",
    "SESSION_TTL_SECONDS": "31536000",
    "CLOUD_PUSH_REGISTRATION_ENABLED": "true",
    "CLOUD_PUSH_MODE": "new_a_owner_scheduled",
    "CLOUD_PUSH_MEMBERSHIP_POLICY": "whop_managed_discord_role",
    "CLOUD_PUSH_AUDIENCE": "paid",
    "CLOUD_PUSH_SCHEDULER_ENABLED": "false",
    "CLOUD_NEW_A_OWNER_PUSH_ENABLED": "true",
    "CLOUD_VAPID_PUBLIC_KEY": "BGr6bbvNlYvIHrZx58m6BFNQOaWBnBNxMwuuAdOkxewJSkm2zdKT3LTlyl5H4e_cFpJ-CqDkZmN7ilu775RXAqQ",
    "CLOUD_VAPID_SUBJECT": "https://tentei-kyokuchi-cloud.ipo-ken5-5489.workers.dev/"
  },
  "triggers": {
    "crons": ["0 23 * * *", "*/5 8-14 * * *"]
  },
  "env": {
    "preview": {
      "name": "tentei-kyokuchi-cloud-preview",
      "preview_urls": false,
      "d1_databases": [],
      "durable_objects": {
        "bindings": [{ "name": "CLOUD_ROLE_AUTHORITY", "class_name": "CloudRoleAuthority" }]
      },
      "vars": {
        "DISCORD_API_BASE": "https://discord.com/api",
        "DISCORD_GUILD_ID": "1479418833352785944",
        "DISCORD_ALLOWED_ROLE_IDS": "1487089073385373828",
        "ACCESS_PURCHASE_URL": "https://whop.com/scoring-bot/tenteikyokuchi/",
        "REPORT_ASSET_PATH": "/weak_early_beta_latest.html",
        "SESSION_TTL_SECONDS": "31536000",
        "CLOUD_PUSH_REGISTRATION_ENABLED": "false",
        "CLOUD_PUSH_MODE": "disabled"
      }
    }
  },
  "keep_vars": true
}
